		"@vuelidate/core": "^2.0.3",
		"@vuelidate/validators": "^2.0.4",
		"axios": "^1.20.0",
		"electron-args": "^0.1.0",
		"electron-store": "^8.2.0",
		"electron-updater": "^6.8.9",
		"electron-window-state": "^5.0.3",
		"eslint-plugin-vuejs-accessibility": "^2.6.0",
